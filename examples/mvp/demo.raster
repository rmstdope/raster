// The MVP demo: a picture imported from a PNG, with colour
// bars that start on chosen lines of the screen.
//
// art/picture.png is a test card. The yellow numbers on its
// ruler mark lines 60, 120 and 180: each tint should start
// exactly on its mark. Build it with
//
//     rasterc examples/mvp/demo.raster
//
// and open demo.nes in an emulator.

target nes { mapper: mmc3  region: ntsc }

asset image picture = png("art/picture.png") { kind: background  palette: auto(4) }
chrrom bank 0 { picture.tiles }

main {
    load_palette(picture.palette)
    load_nametable(picture.nametable, picture.attributes)
    ppu.ctrl = $08   // background tiles from $0000, sprites from $1000
    ppu.mask = $1e   // rendering on, no tint
}

frame bars using irq {
    at scanline  60 { ppu.mask = $3e }   // red tint (green on a PAL console)
    at scanline 120 { ppu.mask = $5e }   // green tint (red on a PAL console)
    at scanline 180 { ppu.mask = $1e }   // no tint again
}
