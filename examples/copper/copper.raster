// A copper bar: one colour per scanline, set as the beam reaches it,
// swinging up and down the screen on a sine.
//
// Rendering stays off, and with it off the PPU shows the palette entry
// its address register points at (see .cerebro/traps.md). So the bar is
// five palette entries, dark to white, and every scanline points the
// address at the one its line of the bar needs, or at the black
// backdrop. A `frame ... using timed` schedule runs that handler on 239
// scanlines as a loop.
//
// Build it with
//
//     rasterc examples/copper/copper.raster
//
// and open copper.nes in an emulator.

target nes { mapper: mmc3  region: ntsc }

// Which palette entry each line of the bar shows, counted from its top:
// 9 lines, one per shade, white in the middle. Every entry past the bar
// is $00, the backdrop, so a line above or below the bar reads black.
const BAR: [256]u8 = [
    $01, $02, $03, $04, $05, $04, $03, $02, $01, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
    $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
]

// The bar's top line for each step of the swing: two whole swings,
// between lines 16 and 215.
const SWING: [256]u8 = [
    116, 120, 125, 130, 135, 140, 144, 149, 154, 158, 162, 167, 171, 175, 179, 182,
    186, 189, 192, 195, 198, 201, 203, 205, 207, 209, 211, 212, 213, 214, 215, 215,
    215, 215, 215, 214, 213, 212, 211, 209, 207, 205, 203, 201, 198, 195, 192, 189,
    186, 182, 179, 175, 171, 167, 162, 158, 154, 149, 144, 140, 135, 130, 125, 120,
    116, 111, 106, 101,  96,  91,  87,  82,  77,  73,  69,  64,  60,  56,  52,  49,
     45,  42,  39,  36,  33,  30,  28,  26,  24,  22,  20,  19,  18,  17,  16,  16,
     16,  16,  16,  17,  18,  19,  20,  22,  24,  26,  28,  30,  33,  36,  39,  42,
     45,  49,  52,  56,  60,  64,  69,  73,  77,  82,  87,  91,  96, 101, 106, 111,
    115, 120, 125, 130, 135, 140, 144, 149, 154, 158, 162, 167, 171, 175, 179, 182,
    186, 189, 192, 195, 198, 201, 203, 205, 207, 209, 211, 212, 213, 214, 215, 215,
    215, 215, 215, 214, 213, 212, 211, 209, 207, 205, 203, 201, 198, 195, 192, 189,
    186, 182, 179, 175, 171, 167, 162, 158, 154, 149, 144, 140, 135, 130, 125, 120,
    116, 111, 106, 101,  96,  91,  87,  82,  77,  73,  69,  64,  60,  56,  52,  49,
     45,  42,  39,  36,  33,  30,  28,  26,  24,  22,  20,  19,  18,  17,  16,  16,
     16,  16,  16,  17,  18,  19,  20,  22,  24,  26,  28,  30,  33,  36,  39,  42,
     45,  49,  52,  56,  60,  64,  69,  73,  77,  82,  87,  91,  96, 101, 106, 111,
]

var step: u8 = 0
var top: u8 = 116
var line: u8 = 1
var shade: u8 = 0

main {
    ppu.ctrl = $00              // NMI off: a timed frame cannot spare its 13 cycles
    ppu.mask = $00              // rendering off, so the address picks the colour

    ppu.addr = $3f
    ppu.addr = $00
    ppu.data = $0f              // $3F00: black, everywhere but the bar
    ppu.data = $02              // $3F01: the bar's edges, darkest
    ppu.data = $12
    ppu.data = $22
    ppu.data = $32
    ppu.data = $30              // $3F05: its middle, white

    ppu.addr = $00              // leave palette space until the first
    ppu.addr = $00              // scanline points somewhere on purpose
}

frame copper using timed {
    // Each handler sets the colour of the line after its own: it waits
    // until the beam is past the right edge of the picture, so the colour
    // changes where nobody can see it, and the next line starts in it.
    every 1 scanlines from 0 to 238 {
        shade = BAR[line - top]
        line += 1
        cycles(42) pad { }
        ppu.addr = $3f
        ppu.addr = shade
    }
    // The bar never reaches the last line or the first, so they stay
    // black, and this handler moves the bar for the next frame. Line 0's
    // handler colours line 1, so that is where the count starts.
    at scanline 239 {
        step += 1
        top = SWING[step]
        line = 1
    }
}
